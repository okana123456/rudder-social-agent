# Public browser configuration. The anon key is intentionally public; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Never prefix these with NEXT_PUBLIC_ or place them in extension/renderer code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_REDIRECT_URI=http://localhost:3000/api/meta/callback
META_GRAPH_VERSION=v26.0
TOKEN_ENCRYPTION_KEY=BASE64_ENCODED_32_BYTE_KEY
OPTIONAL_AI_PROVIDER=openai-compatible
OPTIONAL_AI_PROVIDER_URL=
OPTIONAL_AI_PROVIDER_KEY=

# Desktop/extension public defaults (users can configure them in their local settings).
RUDDER_DASHBOARD_URL=http://localhost:3000
RUDDER_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
RUDDER_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
