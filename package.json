{
  "name": "rudder-social-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev -w @rudder/web",
    "dev:extension": "npm run dev -w @rudder/chrome-extension",
    "dev:desktop": "npm run dev -w @rudder/desktop-agent",
    "build": "npm run build -w @rudder/types && npm run build -w @rudder/config && npm run build -w @rudder/ui && npm run build:web && npm run build:extension && npm run build:desktop",
    "build:web": "npm run build -w @rudder/web",
    "build:extension": "npm run build -w @rudder/chrome-extension",
    "build:desktop": "npm run build -w @rudder/desktop-agent",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:windows": "npm run package:windows -w @rudder/desktop-agent",
    "zip": "powershell -ExecutionPolicy Bypass -File scripts/package.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=22"
  }
}
